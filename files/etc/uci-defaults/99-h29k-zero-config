#!/bin/sh

# H29K QWRT SD-card test configuration

# Use a distinct LAN subnet so testers can identify the SD-card build.
uci set network.lan.device='br-lan'
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.51.1'
uci set network.lan.netmask='255.255.255.0'
uci commit network

# Do not expose a predictable default Wi-Fi password. The AIC8800 radio can
# be enabled and configured after logging in over a direct Ethernet link.
if uci -q get wireless.radio0 >/dev/null; then
	uci set wireless.radio0.disabled='1'
	uci commit wireless
fi

/etc/init.d/network reload 2>/dev/null || true

exit 0
